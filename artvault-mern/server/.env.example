# MongoDB Atlas database for ArtVault
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Development-only JWT configuration
JWT_SECRET=replace-with-a-long-random-secret
# Also protects backup-code/OTP digests. Keep stable; rotating invalidates them.
# For codes to work across localhost/Railway, both servers must use the same
# JWT_SECRET, Atlas database, and Supabase project. Never put this secret in Vercel.
# Backup-code setup/disable requires working SMTP and EMAIL_NOTIFICATIONS_ENABLED.
JWT_EXPIRES_IN=30m
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Supabase Auth token verification
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_SECRET_KEY=<supabase-secret-key>

# Main Admin email for the application
MAIN_ADMIN_EMAIL=gama.orgas.up@phinmaed.com

#SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-email
SMTP_PASSWORD=your-google-app-password
SMTP_FROM="ArtVault <your-smtp-email>"
APP_URL=http://localhost:5173
EMAIL_NOTIFICATIONS_ENABLED=true

# Explicit-content screening runs locally using bundled NSFWJS model weights.
# No key, billing account, or remote API is needed for explicit-content screening.
# It detects sexual content, not graphic violence. Animated images are rejected.
# Scanner errors/busy workers block uploads. Existing images are not rescanned.

# Optional Cloud Vision key for online ownership matching ONLY (requires billing).
# Leave blank to avoid using this service; submissions then await manual review.
GOOGLE_VISION_API_KEY=

# Google Cloud Vision Web Detection is enabled by default. Configure a
# server-side API key; never put the key in VITE_* or client environment values.
# No online matches AND credible creation evidence allow automatic approval.
# Matches, uncertain proof, or unavailable checks wait for manual review.
# Setting false disables web search and sends submissions to manual review.
ARTWORK_WEB_CHECK_ENABLED=false

# Gemini compares artwork and creation proof. Keep this key server-side.
# Missing key or failed assessment sends submissions to manual review.
# Artwork and private proof images are sent to Gemini for analysis.
GEMINI_API_KEY=
ARTWORK_PROOF_MODEL=gemini-2.5-flash
